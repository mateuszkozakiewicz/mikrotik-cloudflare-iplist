{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "timezone": "Europe/Warsaw",
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "ignoreTests": true
  },
  "packageRules": [
    {
      "description": "One PR for all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "One PR for all Python dependency updates (pyproject.toml + uv.lock)",
      "matchManagers": ["pep621"],
      "groupName": "python dependencies"
    },
    {
      "description": "Automerge non-major updates (no PR checks exist, workflow only runs on main)",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "ignoreTests": true,
      "automerge": true
    }
  ]
}
